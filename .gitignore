node_modules
dist
*.tsbuildinfo
dist-ssr
*.local

# 비밀값 — 실제 키가 담기는 파일은 절대 올리지 않는다.
# 새 이름(.env.production 등)이 생겨도 걸리도록 넓게 막고, 비밀이 없는 두 파일만 예외로 둔다.
.env
.env.*
!.env.example
!.env.preview
.dev.vars

# 로그
logs
*.log
npm-debug.log*

# 에디터
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# 디자인 시안 원본 (참조용 — 빌드·배포에 포함되지 않음)
/Design

# 팀 공유 프리뷰 빌드 산출물
/preview

# 음원 원본 (리드 로컬 보관) — 사이트가 쓰는 것은 public/music 쪽이다.
# 둘 다 올리면 같은 파일이 두 벌 들어가 저장소가 그만큼 무거워진다.
/음악
