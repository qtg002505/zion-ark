# 시온 아크 — 환경 변수 예시
#
# 사용법: 이 파일을 `.env`로 복사한 뒤 값을 채운다. `.env`는 git에 올라가지 않는다.
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
#
# 배포(Vercel)에서는 파일을 올리지 않고 프로젝트 설정 > Environment Variables에 등록한다.
# 자세한 절차는 docs/DEPLOY.md 참고.


# ─────────────────────────────────────────────────────────────
# ⚠️ 먼저 읽을 것 — 어떤 변수가 공개되는가
#
# Vite는 `VITE_`로 시작하는 변수만 앱에 넣어 주는데, 그 값은 **빌드 결과물에 그대로 박혀
# 브라우저에서 누구나 볼 수 있다**. 그러니 여기에는 공개돼도 괜찮은 설정만 둔다.
#
# API 키·토큰처럼 **감춰야 하는 값에는 `VITE_`를 붙이지 않는다.** 그런 값은 서버 쪽
# (Vercel Serverless Function 등)에서만 읽어 쓴다. 클라이언트가 키를 직접 들고
# 외부 API를 부르면 키가 그대로 노출된다.
# ─────────────────────────────────────────────────────────────


# ── 공개돼도 되는 설정 (VITE_ 접두사) ──

# 라우터 방식. 비워 두면 경로 라우팅(BrowserRouter)을 쓴다.
# 팀 공유 프리뷰처럼 서버 라우팅이 없는 정적 호스팅에서만 hash 로 둔다.
VITE_ROUTER=

# AI 질문 기능이 호출할 우리 서버 경로. 비워 두면 로컬 검색으로 동작한다.
# 예: /api/ask  — 키를 들고 있는 쪽은 서버이고, 브라우저는 이 경로만 안다.
VITE_ASK_API_PATH=


# ── 감춰야 하는 값 (VITE_ 없음 · 서버에서만 읽음) ──
# 아래 값들은 브라우저로 내려가지 않는다. 로컬에서는 .env 에, 배포에서는
# Vercel 환경 변수에 넣는다.

# AI 응답 연결용 키 (docs/HANDOFF.md의 "AI 질문 실제 API 연결" 항목)
ANTHROPIC_API_KEY=

# 백엔드 연동 시 사용할 API 서버 주소·자격 (아직 미확정 — 붙일 때 이름을 맞춘다)
API_BASE_URL=
API_TOKEN=
